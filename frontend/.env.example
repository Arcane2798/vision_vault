# Copy to .env.local, or run:  npm run configure

# Name shown in the sidebar and browser tab
VITE_APP_NAME=Township CCTV

# mock = clearly labelled sample data (no backend needed), live = real backend API
VITE_DATA_MODE=mock

# Backend REST API base URL (live mode)
VITE_API_BASE_URL=http://localhost:8000/api

# Real-time alerts: websocket | sse | mock | off
VITE_REALTIME=mock
VITE_REALTIME_URL=ws://localhost:8000/ws/events

# true = login required. false = no login (local demo only)
VITE_AUTH_ENABLED=true

# How often dashboard / lists refresh (milliseconds)
VITE_REFRESH_INTERVAL_MS=15000

# Hide AI detections below this confidence (0-1)
VITE_MIN_CONFIDENCE=0.5

# Time zone used for every timestamp
VITE_TIMEZONE=Asia/Kuala_Lumpur

# Dev server port
PORT=5173
